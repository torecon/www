Options -Indexes

# HTTPS-Redirect übernimmt Plesk (nginx), hier nur Security-Header.
#
# CSP passend zu den Seiten unter getthinkless.ai (index, privacy, terms):
# alles self-hosted (style.css, PNGs), keine externen Skripte/Schriften/Frames.
# 'unsafe-inline' ist nötig, solange die Seiten ihre Sprachumschaltung als
# Inline-<script> mit onclick-Handlern und Inline-style-Attribute nutzen.
# Neue externe Ressource (CDN, Font, Embed) → CSP hier erweitern, sonst blockiert.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# v1.6 Universal Link: Apple lädt die AASA über sein CDN. Pflicht: HTTPS, kein
# Redirect, Content-Type application/json (die Datei hat keine Endung).
<Files "apple-app-site-association">
  ForceType application/json
</Files>

# v1.6 Vorschauseite /d/ (geteilte Entscheidung, Inhalt nur im Fragment #…):
# nicht indexieren, keinen Referrer weitergeben, strenge CSP ohne Inline-Skripte
# (nur /d/preview.js, kein Netzwerkzugriff). Ersetzt für /d/ die CSP oben;
# 'unsafe-inline' nur für style (Seiten-<style>, Inhalte nur per textContent).
<If "%{REQUEST_URI} =~ m#^/d(/|$)#">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; upgrade-insecure-requests"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</If>
