# HTTPS-Redirect übernimmt Plesk (nginx). Diese Datei regelt nur, was der
# App-Link v2.7 (Backlog 241) braucht; weitere Sicherheits-Header für die
# ganze Domain entscheidet landingpage-guardian (Vorlage getthinkless.ai/.htaccess).

# Universal Link: Apple lädt die AASA über sein CDN. Pflicht: HTTPS, kein
# Redirect, Content-Type application/json (die Datei hat keine Endung).
<Files "apple-app-site-association">
  ForceType application/json
</Files>

# Ausweichseite /app/ (Ziel eines App-Links ohne installierte App):
# nicht indexieren, keinen Referrer weitergeben, strenge CSP — die Seite hat
# kein Skript und lädt nur eigene Bilder und Inline-Styles.
<If "%{REQUEST_URI} =~ m#^/app(/|$)#">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set X-Content-Type-Options "nosniff"
  </IfModule>
</If>
